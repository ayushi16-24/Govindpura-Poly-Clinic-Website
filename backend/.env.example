# Server
PORT=5000
NODE_ENV=development

# Frontend ka URL (CORS). Ek se zyada ho to comma se alag karein.
# Production example: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (database ka naam /govindpura-clinic jaisa end mein rakhein)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/govindpura-clinic?retryWrites=true&w=majority

# JWT: kam se kam 32 characters ka lamba random string
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Pehla admin (sirf `npm run seed:admin` ke time use hota hai)
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_min_8_chars
